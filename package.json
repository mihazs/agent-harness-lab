{
  "name": "agent-harness-lab",
  "version": "0.17.0",
  "private": true,
  "scripts": {
    "hooks:install": "python3 scripts/install_hooks.py",
    "duplication:check": "python3 scripts/check_duplicates.py",
    "duplication:report": "jscpd --config .jscpd.json --no-colors",
    "changeset": "changeset",
    "version-packages": "changeset version && python3 scripts/sync_version.py",
    "release": "python3 scripts/publish_release.py"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "jscpd": "5.4.2",
    "lefthook": "2.2.2"
  }
}
